# Use deterministic local data without third-party API keys.
NEXT_PUBLIC_USE_MOCK_SERVICES=true

# Set mock services to false and provide these values for live maps and weather.
NEXT_PUBLIC_MAPS_KEY=
MAPS_SECRET=
OWM_KEY=

# Public deployment URL used by sitemap and robots metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
